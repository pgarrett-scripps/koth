# version and date-released are written by `just cite-sync` at release time and
# checked against Cargo.toml in CI; never edit them by hand. Keep identities and
# description synchronized with .zenodo.json; omit funding.
cff-version: 1.2.0
message: "If you use koth, please cite this software using these metadata."
title: "koth: fast, memory-efficient MS1 feature detection"
abstract: "koth is a Rust tool for peptide feature detection in LC-MS data. It reads mzML, Bruker timsTOF, and Thermo RAW files and reports chromatographic traces and isotope envelopes. The included koth_align tool supports multi-run alignment and exploratory label-free quantification."
type: software
version: "0.11.0"
date-released: "2026-09-25"
